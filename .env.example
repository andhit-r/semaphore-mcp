# Contoh konfigurasi Semaphore MCP Server. Salin menjadi .env dan isi nilainya.

# ── Koneksi ke Semaphore UI ───────────────────────────────────────────────────
# URL dasar Semaphore UI (wajib diisi)
SEMAPHORE_URL=http://localhost:3000
# Pilih salah satu metode auth Semaphore:
# Option 1: API Token (lebih aman, direkomendasikan)
SEMAPHORE_API_TOKEN=
# Option 2: Username + Password (fallback)
SEMAPHORE_USERNAME=admin
SEMAPHORE_PASSWORD=changeme
# Timeout request HTTP ke Semaphore (detik)
SEMAPHORE_TIMEOUT=30.0
# Verifikasi TLS certificate server Semaphore (true/false)
SEMAPHORE_VERIFY_SSL=true

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=Semaphore UI MCP
MCP_LOG_LEVEL=INFO

# Transport saat `python -m semaphore_mcp` (stdio | http | sse).
# Untuk Docker/cloud, uvicorn memakai semaphore_mcp.asgi:app (lihat Dockerfile).
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── OAuth via Authentik (WAJIB untuk Claude Web / claude.ai) ──────────────────
# URL publik MCP server ini (untuk redirect OAuth). Contoh: https://mcp.example.com
MCP_BASE_URL=

# URL dasar Authentik. Contoh: https://auth.example.com
AUTHENTIK_BASE_URL=
# Slug OAuth2/OIDC Provider di Authentik. Contoh: semaphore-mcp
AUTHENTIK_APP_SLUG=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# preferred_username yang diizinkan. Format: comma-separated (akadmin,user2),
# nilai tunggal (akadmin), atau JSON array (["akadmin","user2"]). Kosong = semua diizinkan.
AUTHENTIK_ALLOWED_USERNAMES=

# ── API Key (klien non-OAuth: VS Code / CLI) ──────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Kosongkan untuk menonaktifkan (lokal/stdio).
MCP_API_KEY=
